<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Sirena">
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <title>Sirena - Control de Inventario</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div id="toast" class="toast"></div>
  <nav>
    <div class="nav-left">
      <button id="btn-back" class="btn-back" style="display:none" onclick="volverMenu()">←</button>
      <h1 class="nav-logo">SIRENA <span class="nav-logo-sub">DE JUAN</span></h1>
    </div>
    <div id="user-info" class="user-info" style="display:none">
      <span id="user-email" class="user-email"></span>
      <button id="btn-salir" class="btn-salir">Salir</button>
    </div>
  </nav>

  <!-- Main menu -->
  <div id="main-menu" class="main-menu">
    <div id="menu-flow-container" class="menu-flow-container">
      <svg id="menu-flow-svg" class="menu-flow-svg" aria-hidden="true"></svg>
      <div class="main-menu-grid">
        <button class="category-btn menu-compras" id="btn-compras" onclick="irACategoria('compras')">
          <span class="category-icon">🛒</span>
          <span class="category-label">COMPRAS</span>
          <span class="category-desc">Compras que ingresan a Stocks, Barra y Cocina</span>
        </button>
        <button class="category-btn menu-stocks" onclick="irACategoria('stocks')">
          <span class="category-icon">📦</span>
          <span class="category-label">STOCKS</span>
          <span class="category-desc">Ingresos, Salidas, Ventas, Almacenes, Stocks, Reportes, Precios</span>
          <span class="category-items" id="menu-items-stocks">Items: —</span>
        </button>
        <button class="category-btn menu-barra" onclick="irACategoria('barra')">
          <span class="category-icon">🍸</span>
          <span class="category-label">BARRA</span>
          <span class="category-desc">Recetas, Stock y Base de Datos de la Barra</span>
          <span class="category-items" id="menu-items-barra">Items: —</span>
        </button>
        <button class="category-btn menu-cocina" onclick="irACategoria('cocina')">
          <span class="category-icon">🍳</span>
          <span class="category-label">COCINA</span>
          <span class="category-desc">Recetas, Stock y Base de Datos de la Cocina</span>
          <span class="category-items" id="menu-items-cocina">Items: —</span>
        </button>
        <button class="category-btn menu-costos" onclick="irACategoria('costos')">
          <span class="category-icon">💰</span>
          <span class="category-label">CONSOLIDADO</span>
          <span class="category-desc">Planillas, Servicios y Gastos Operativos</span>
        </button>
        <button class="category-btn menu-ventas" id="btn-ventas" onclick="irACategoria('ventas')">
          <span class="category-icon">🛍️</span>
          <span class="category-label">VENTAS</span>
          <span class="category-desc">Ventas que salen de Stocks, Barra y Cocina</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Tabs bar (STOCKS) -->
  <div id="tabs-bar" class="tabs-bar" style="display:none">
    <div class="tabs">
      <button class="tab" data-tab="ingresos">Ingresos</button>
      <button class="tab" data-tab="salidas">Salidas</button>
      <button class="tab" data-tab="ventas">Ventas</button>
      <button class="tab" data-tab="bajas">Bajas</button>
      <button class="tab active" data-tab="almacenes">Almacenes</button>
      <button class="tab" data-tab="stocks">Stocks</button>
      <button class="tab" data-tab="reportes">Reportes</button>
      <button class="tab" data-tab="precios">Base de Datos</button>
      <button class="tab" data-tab="busquedaventas">Búsqueda Ventas</button>
    </div>
  </div>

  <!-- Tabs bar (BARRA) -->
  <div id="tabs-barra" class="tabs-bar" style="display:none">
    <div class="tabs">
      <button class="sub-tab" data-subtab="ingresos" onclick="cambiarSubTab('ingresos')">Ingresos</button>
      <button class="sub-tab" data-subtab="ventas" onclick="cambiarSubTab('ventas')">Ventas</button>
      <button class="sub-tab" data-subtab="bajas" onclick="cambiarSubTab('bajas')">Bajas</button>
      <button class="sub-tab" data-subtab="stock" onclick="cambiarSubTab('stock')">Stock</button>
      <button class="sub-tab active" data-subtab="recetas" onclick="cambiarSubTab('recetas')">Recetas</button>
      <button class="sub-tab" data-subtab="basedatos" onclick="cambiarSubTab('basedatos')">Base de Datos</button>
    </div>
  </div>

  <!-- Tabs bar (COCINA) -->
  <div id="tabs-cocina" class="tabs-bar" style="display:none">
    <div class="tabs">
      <button class="sub-tab" data-subtab="ingresos" onclick="cambiarSubTab('ingresos','cocina')">Ingresos</button>
      <button class="sub-tab" data-subtab="salidas" onclick="cambiarSubTab('salidas','cocina')">Salidas</button>
      <button class="sub-tab" data-subtab="ventas" onclick="cambiarSubTab('ventas','cocina')">Ventas</button>
      <button class="sub-tab active" data-subtab="recetas" onclick="cambiarSubTab('recetas','cocina')">Recetas</button>
      <button class="sub-tab" data-subtab="stock" onclick="cambiarSubTab('stock','cocina')">Stock</button>
      <button class="sub-tab" data-subtab="basedatos" onclick="cambiarSubTab('basedatos','cocina')">Base de Datos</button>
    </div>
  </div>

  <!-- Tabs bar (COSTOS) - se carga dinámicamente -->
  <div id="tabs-costos" class="tabs-bar" style="display:none">
    <div class="tabs"></div>
  </div>

  <div class="container" id="container">
    <div id="tab-almacenes" class="tab-content active">
      <div class="header-actions">
        <h2>Almacenes</h2>
        <div class="controles-dia">
          <label>Fecha: <input type="date" id="fecha-almacenes" onchange="cargarAlmacenes(this.value)"></label>
          <input type="text" id="buscar-item" placeholder="Buscar item..." oninput="buscarEnTabla(this.value, 'accordion-almacenes')">
          <button class="btn-detalles" id="btn-ver-cero" onclick="toggleVerCero()" title="Ocultar items con stock 0" style="font-size:1.1rem;">🙈</button>
          <button class="btn-guardar-dia" onclick="guardarDia()">💾 GUARDAR</button>
          <button class="btn-detalles" onclick="exportarExcel()">Exportar</button>
        </div>
      </div>
      <div id="accordion-almacenes"></div>
    </div>

    <div id="tab-ingresos" class="tab-content">
      <div class="header-actions">
        <h2>Ingresos</h2>
        <div class="controles-dia">
          <label>Fecha: <input type="date" id="fecha-ingresos" onchange="cargarIngresos(this.value)"></label>
          <input type="text" id="buscar-ingreso" placeholder="Buscar item..." oninput="buscarEnTabla(this.value, 'accordion-ingresos')">
          <button class="btn-guardar-dia" onclick="guardarIngresos()">💾 GUARDAR INGRESOS</button>
          <button class="btn-detalles" onclick="verDetallesIngresos()">📋 DETALLES</button>
        </div>
      </div>
      <div id="accordion-ingresos"></div>
    </div>

    <div id="tab-salidas" class="tab-content">
      <div class="header-actions">
        <h2>Salidas</h2>
        <div class="controles-dia">
          <label>Fecha: <input type="date" id="fecha-salidas" onchange="cargarSalidas(this.value)"></label>
          <input type="text" id="buscar-salida" placeholder="Buscar item..." oninput="buscarEnTabla(this.value, 'accordion-salidas')">
          <button class="btn-guardar-dia" onclick="guardarSalidas()">💾 GUARDAR SALIDAS</button>
          <button class="btn-detalles" onclick="verDetallesSalidas()">📋 DETALLES</button>
        </div>
      </div>
      <div id="accordion-salidas"></div>
    </div>

    <div id="tab-ventas" class="tab-content">
      <div class="header-actions">
        <h2>Ventas</h2>
        <div class="controles-dia">
          <label>Fecha: <input type="date" id="fecha-ventas" onchange="cargarVentas(this.value)"></label>
          <input type="text" id="buscar-venta" placeholder="Buscar item..." oninput="buscarEnTabla(this.value, 'accordion-ventas')">
          <button class="btn-guardar-dia" onclick="guardarVentas()">💾 GUARDAR VENTAS</button>
          <button class="btn-detalles" onclick="verDetallesVentas()">📋 DETALLES</button>
        </div>
      </div>
      <div id="accordion-ventas"></div>
    </div>

    <div id="tab-bajas" class="tab-content">
      <div class="header-actions">
        <h2>Bajas</h2>
        <div class="controles-dia">
          <label>Fecha: <input type="date" id="fecha-bajas" onchange="cargarBajas(this.value)"></label>
          <input type="text" id="buscar-baja" placeholder="Buscar item..." oninput="buscarEnTabla(this.value, 'accordion-bajas')">
          <button class="btn-guardar-dia" onclick="guardarBajas()">💾 GUARDAR BAJAS</button>
          <button class="btn-detalles" onclick="verDetallesBajas()">📋 DETALLES</button>
        </div>
      </div>
      <div id="accordion-bajas"></div>
    </div>

    <div id="tab-stocks" class="tab-content">
      <div class="header-actions">
        <h2>Stocks</h2>
        <div class="controles-dia">
          <label>Fecha: <input type="date" id="fecha-stocks" onchange="cargarStocks()"></label>
          <input type="text" id="buscar-stock" placeholder="Buscar item..." oninput="buscarEnTabla(this.value, 'accordion-stocks')">
          <button class="btn-guardar-dia" onclick="guardarMinimosStocks()">💾 GUARDAR MINIMOS</button>
          <button class="btn-detalles" onclick="verReporteStocksBajos()">📋 REPORTES</button>
        </div>
      </div>
      <div id="accordion-stocks"></div>
    </div>

    <div id="tab-reportes" class="tab-content">
      <div class="header-actions">
        <h2>Reportes</h2>
        <div class="controles-dia">
          <label>Desde: <input type="date" id="reporte-fecha-ini" onchange="cargarReporteDiferencias()"></label>
          <label>Hasta: <input type="date" id="reporte-fecha-fin" onchange="cargarReporteDiferencias()"></label>
          <button onclick="exportarDiferencias()">Exportar</button>
          <button onclick="exportarVinos()" style="background:#4a148c;color:#fff;border:none;padding:0.5rem 1rem;border-radius:4px;cursor:pointer;">Exportar Vinos</button>
        </div>
      </div>
      <div id="reporte-diferencias"></div>
    </div>

    <div id="tab-precios" class="tab-content">
      <div class="header-actions">
        <h2>Base de Datos</h2>
        <div class="controles-dia">
          <button onclick="mostrarModalAgregarItemStocks()">AGREGAR ITEM</button>
          <input type="text" id="buscar-precio-item" placeholder="Buscar..." style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;font-size:0.9rem;width:250px;" oninput="buscarTablaBarra(this.value, 'accordion-precios', 'tr[data-precio-id]')">
          <button class="btn-guardar-dia" onclick="guardarPreciosStocks()">💾 GUARDAR</button>
          <button class="btn-detalles" onclick="exportarBaseDatosStocks()">EXPORTAR</button>
          <button class="btn-detalles" onclick="exportarBaseDatosSinPrecioStocks()" style="background:#b71c1c;">EXPORTAR SIN PRECIO</button>
        </div>
        <div style="font-size:0.75rem;color:#888;margin-top:0.3rem;">Anota la unidad, el precio de compra (proveedor) y el precio de venta al consumidor de los items de STOCKS/ALMACEN.</div>
      </div>
      <div id="accordion-precios"></div>
    </div>

    <div id="tab-barra" class="tab-content">
      <div id="sub-barra-ingresos" class="sub-tab-content">
        <div class="header-actions">
          <h2>Ingresos Barra</h2>
          <div class="controles-dia">
            <label>Fecha: <input type="date" id="fecha-barra-ingresos" onchange="cargarBarraMovimientos('ingresos')"></label>
            <input type="text" id="buscar-barra-ingresos" placeholder="Buscar item..." oninput="buscarSmart(this.value,'accordion-barra-ingresos','tr[data-ing]')">
            <button class="btn-guardar-dia" onclick="guardarBarraMovimientos('ingresos')">💾 GUARDAR INGRESOS</button>
            <button class="btn-detalles" onclick="verDetallesBarra('ingresos')">📋 DETALLES</button>
          </div>
        </div>
        <div id="accordion-barra-ingresos"></div>
      </div>

      <div id="sub-barra-ventas" class="sub-tab-content">
        <div class="header-actions">
          <h2>Ventas Barra</h2>
          <div class="controles-dia">
            <label>Fecha: <input type="date" id="fecha-barra-ventas" onchange="cargarBarraMovimientos('ventas')"></label>
            <input type="text" id="buscar-barra-ventas" placeholder="Buscar receta..." oninput="buscarTablaBarra(this.value,'accordion-barra-ventas','tr[data-receta]')">
            <button class="btn-guardar-dia" onclick="guardarBarraMovimientos('ventas')">💾 GUARDAR VENTAS</button>
            <button class="btn-detalles" onclick="verDetallesBarra('ventas')">📋 DETALLES</button>
          </div>
        </div>
        <div id="accordion-barra-ventas"></div>
      </div>

      <div id="sub-barra-bajas" class="sub-tab-content">
        <div class="header-actions">
          <h2>Bajas Barra</h2>
          <div class="controles-dia">
            <label>Fecha: <input type="date" id="fecha-barra-bajas" onchange="cargarBarraMovimientos('bajas')"></label>
            <input type="text" id="buscar-barra-bajas" placeholder="Buscar item..." oninput="buscarSmart(this.value,'accordion-barra-bajas','tr[data-ing]')">
            <button class="btn-guardar-dia" onclick="guardarBarraMovimientos('bajas')">💾 GUARDAR BAJAS</button>
            <button class="btn-detalles" onclick="verDetallesBarra('bajas')">📋 DETALLES</button>
          </div>
        </div>
        <div id="accordion-barra-bajas"></div>
      </div>

      <div id="sub-barra-recetas" class="sub-tab-content active">
        <div class="header-actions">
          <h2>Recetas</h2>
          <div class="controles-dia" style="display:flex;align-items:center;gap:0.5rem;">
            <input type="text" id="buscar-receta" placeholder="Buscar receta o ingrediente..." style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;font-size:0.9rem;width:250px;" oninput="buscarReceta(this.value)">
            <button onclick="exportarRecetas()">EXPORTAR</button>
          </div>
        </div>
        <div style="margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;padding:1rem;background:#f9f9f9;border-radius:8px;">
          <input type="text" id="nueva-receta-input" placeholder="Nueva receta..." style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;flex:1;min-width:150px;">
          <select id="nueva-receta-cat" style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;">
            <option value="RECETAS BASE">RECETAS BASE</option>
            <option value="Clásicos">Clásicos</option>
            <option value="Mojitos">Mojitos</option>
            <option value="Limonadas">Limonadas</option>
            <option value="LIMONADAS MENU">LIMONADAS MENU</option>
            <option value="SODAS">SODAS</option>
            <option value="JUGO DE FRUTAS">JUGO DE FRUTAS</option>
            <option value="DEL BARMAN">DEL BARMAN</option>
            <option value="Chilcanos y Sours">Chilcanos y Sours</option>
            <option value="SHOTS">SHOTS</option>
            <option value="VINO TINTOS">VINO TINTOS</option>
          </select>
          <button onclick="guardarReceta()">AGREGAR RECETA</button>
        </div>
        <div id="recetas-container"></div>
      </div>

      <div id="sub-barra-stock" class="sub-tab-content">
        <div class="header-actions">
          <h2>Stock Barra</h2>
          <div class="controles-dia" style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
            <input type="text" id="buscar-stock-barra" placeholder="Buscar en stock..." list="sugerencia-stock-buscar" autocomplete="off" style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;font-size:0.9rem;width:250px;" oninput="buscarTablaBarra(this.value, 'barra-stock-container', 'tr[data-stock-id]')" onchange="normalizarBusquedaStock(this)">
            <datalist id="sugerencia-stock-buscar"></datalist>
            <label style="display:flex;align-items:center;gap:0.3rem;">Fecha:
              <input type="date" id="fecha-stock-barra" onchange="cargarStockBarra()" style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;font-size:0.9rem;">
            </label>
            <button onclick="exportarStockBarra()" style="padding:0.5rem 1rem;background:#2e7d32;color:#fff;border:none;border-radius:6px;font-size:0.9rem;font-weight:700;cursor:pointer;">📊 EXPORTAR EXCEL</button>
            <span id="barra-stock-add-form" style="display:inline-flex;gap:0.4rem;align-items:center;flex-wrap:wrap;">
              <input type="text" id="nuevo-stock-input" placeholder="Ingrediente" list="sugerencia-stock-input" autocomplete="off" style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;font-size:0.9rem;width:170px;">
              <datalist id="sugerencia-stock-input"></datalist>
              <input type="number" id="nuevo-stock-cant" placeholder="Cant." step="0.01" style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;font-size:0.9rem;width:80px;">
              <select id="nuevo-stock-uni" style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;font-size:0.9rem;width:90px;">
                <option value="ml">ml</option>
                <option value="unidad">unidad</option>
                <option value="onzas">onzas</option>
                <option value="gramos">gramos</option>
                <option value="kg">kg</option>
                <option value="lt">lt</option>
                <option value="hojas">hojas</option>
                <option value="gotas">gotas</option>
                <option value="rodajas">rodajas</option>
              </select>
              <select id="nuevo-stock-grupo" style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;font-size:0.9rem;width:170px;">
                <option value="MUEBLE DE ARRIBA">MUEBLE DE ARRIBA</option>
                <option value="MUEBLE DE ABAJO">MUEBLE DE ABAJO</option>
                <option value="MUEBLE DE APOYO">MUEBLE DE APOYO</option>
              </select>
              <button onclick="agregarStockBarra()">AGREGAR ITEM</button>
              <button id="btn-guardar-stock" onclick="guardarStockBarra()" style="padding:0.5rem 1rem;background:#2e7d32;color:#fff;border:none;border-radius:6px;font-size:0.9rem;font-weight:700;cursor:pointer;">💾 GUARDAR STOCK</button>
            </span>
          </div>
          <div id="barra-stock-banner" style="display:none"></div>
        </div>
        <div id="barra-stock-container"></div>
      </div>

      <div id="sub-barra-basedatos" class="sub-tab-content">
        <div class="header-actions">
          <h2>Base de Datos</h2>
          <div class="controles-dia" style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
            <button onclick="mostrarModalAgregarItem()">AGREGAR ITEM</button>
            <input type="text" id="buscar-precios" placeholder="Buscar..." style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;font-size:0.9rem;width:200px;" oninput="buscarTablaBarra(this.value, 'barra-precios-container', 'tr[data-precio-id]')">
            <button class="btn-guardar-dia" onclick="guardarPreciosBase()">💾 GUARDAR</button>
            <button class="btn-detalles" onclick="exportarBaseDatos()">EXPORTAR</button>
            <button class="btn-detalles" onclick="exportarBaseDatosSinPrecio()" style="background:#b71c1c;">EXPORTAR SIN PRECIO</button>
          </div>
          <div style="font-size:0.75rem;color:#888;margin-top:0.3rem;">Las conversiones de unidades (onzas, ml, lt) en recetas se calculan automáticamente desde el nombre del item. Ej: "x 20 L" → 1 unidad = 20000 ml.</div>
        </div>
        <div id="barra-precios-container"></div>
      </div>
    </div>

    <div id="tab-cocina" class="tab-content">
      <div id="sub-cocina-ingresos" class="sub-tab-content">
        <div class="header-actions">
          <h2>Ingresos Cocina</h2>
          <div class="controles-dia">
            <label>Fecha: <input type="date" id="fecha-cocina-ingresos" onchange="cargarCocinaMovimientos('ingresos')"></label>
            <input type="text" id="buscar-cocina-ingresos" placeholder="Buscar item..." oninput="buscarEnTabla(this.value, 'accordion-cocina-ingresos')">
            <button class="btn-guardar-dia" onclick="guardarCocinaMovimientos('ingresos')">💾 GUARDAR INGRESOS</button>
            <button class="btn-detalles" onclick="verDetallesCocina('ingresos')">📋 DETALLES</button>
          </div>
        </div>
        <div id="accordion-cocina-ingresos"></div>
      </div>

      <div id="sub-cocina-salidas" class="sub-tab-content">
        <div class="header-actions">
          <h2>Salidas Cocina</h2>
          <div class="controles-dia">
            <label>Fecha: <input type="date" id="fecha-cocina-salidas" onchange="cargarCocinaMovimientos('salidas')"></label>
            <input type="text" id="buscar-cocina-salidas" placeholder="Buscar item..." oninput="buscarEnTabla(this.value, 'accordion-cocina-salidas')">
            <button class="btn-guardar-dia" onclick="guardarCocinaMovimientos('salidas')">💾 GUARDAR SALIDAS</button>
            <button class="btn-detalles" onclick="verDetallesCocina('salidas')">📋 DETALLES</button>
          </div>
        </div>
        <div id="accordion-cocina-salidas"></div>
      </div>

      <div id="sub-cocina-ventas" class="sub-tab-content">
        <div class="header-actions">
          <h2>Ventas Cocina</h2>
          <div class="controles-dia">
            <label>Fecha: <input type="date" id="fecha-cocina-ventas" onchange="cargarCocinaMovimientos('ventas')"></label>
            <input type="text" id="buscar-cocina-ventas" placeholder="Buscar receta..." oninput="buscarTablaBarra(this.value, 'accordion-cocina-ventas', 'tr[data-receta]')">
            <button class="btn-guardar-dia" onclick="guardarCocinaMovimientos('ventas')">💾 GUARDAR VENTAS</button>
            <button class="btn-detalles" onclick="verDetallesCocina('ventas')">📋 DETALLES</button>
          </div>
        </div>
        <div id="accordion-cocina-ventas"></div>
      </div>

      <div id="sub-cocina-recetas" class="sub-tab-content active">
        <div class="header-actions">
          <h2>Recetas</h2>
          <div class="controles-dia" style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
            <input type="text" id="buscar-receta-cocina" placeholder="Buscar receta o ingrediente..." style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;font-size:0.9rem;width:250px;" oninput="buscarRecetaCocina(this.value)">
            <button onclick="exportarRecetasCocina()">EXPORTAR</button>
          </div>
        </div>
        <div style="margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;padding:1rem;background:#f9f9f9;border-radius:8px;">
          <input type="text" id="nueva-receta-cocina-input" placeholder="Nueva receta..." style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;flex:1;min-width:150px;">
          <select id="nueva-receta-cocina-cat" style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;">
            <option value="PLATOS">Platos</option>
            <option value="ENTRADAS">Entradas</option>
            <option value="SOPAS">Sopas</option>
            <option value="CARNES">Carnes</option>
            <option value="MARISCOS">Mariscos</option>
            <option value="POLLO">Pollo</option>
            <option value="GUARNICIONES">Guarniciones</option>
            <option value="POSTRES">Postres</option>
            <option value="OTROS">Otros</option>
          </select>
          <button onclick="guardarRecetaCocina()">AGREGAR RECETA</button>
        </div>
        <div id="cocina-recetas-container"></div>
      </div>

      <div id="sub-cocina-stock" class="sub-tab-content">
        <div class="header-actions">
          <h2>Stock Cocina</h2>
          <div class="controles-dia">
            <label>Fecha: <input type="date" id="fecha-cocina-stock" onchange="cargarStockCocina()"></label>
            <input type="text" id="buscar-cocina-stock" placeholder="Buscar item..." oninput="buscarEnTabla(this.value, 'cocina-stock-container')">
            <button class="btn-guardar-dia" onclick="guardarCocinaDia()">💾 GUARDAR</button>
          </div>
        </div>
        <div id="cocina-stock-container"></div>
      </div>

      <div id="sub-cocina-basedatos" class="sub-tab-content">
        <div class="header-actions">
          <h2>Base de Datos</h2>
          <div class="controles-dia" style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
            <button onclick="mostrarModalAgregarItemCocina()">AGREGAR ITEM</button>
            <input type="text" id="buscar-precios-cocina" placeholder="Buscar..." style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;font-size:0.9rem;width:200px;" oninput="buscarTablaBarra(this.value, 'cocina-precios-container', 'tr[data-precio-id]')">
            <button class="btn-guardar-dia" onclick="guardarPreciosBaseCocina()">💾 GUARDAR</button>
            <button class="btn-detalles" onclick="exportarBaseDatosCocina()">EXPORTAR</button>
            <button class="btn-detalles" onclick="exportarBaseDatosSinPrecioCocina()" style="background:#b71c1c;">EXPORTAR SIN PRECIO</button>
          </div>
          <div style="font-size:0.75rem;color:#888;margin-top:0.3rem;">Los items que ingresan en COCINA/STOCK aparecen automáticamente aquí. Agrega unidad de compra, precio, unidad (de receta) y precio.</div>
        </div>
        <div id="cocina-precios-container"><p>Sin datos aún.</p></div>
      </div>
    </div>

    <div id="tab-costos" class="tab-content">
      <div id="costos-content-area"></div>
    </div>

    <div id="tab-compras" class="tab-content">
      <div class="header-actions">
        <h2>COMPRAS/INGRESOS</h2>
        <div class="controles-dia">
          <label>Fecha: <input type="date" id="fecha-compras" onchange="cargarCompras()"></label>
          <button class="btn-guardar-dia" onclick="guardarCompras()">💾 GUARDAR</button>
        </div>
      </div>
      <div style="margin-bottom:1rem;padding:1rem;background:#f9f9f9;border-radius:8px;">
        <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
          <input type="text" id="nueva-compra-input" placeholder="Buscar item (ej. COCA COLA)..." list="sugerencia-compras" autocomplete="off" style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;flex:1;min-width:180px;" oninput="onBuscarItemCompra(this.value)">
          <datalist id="sugerencia-compras"></datalist>
          <input type="number" id="nueva-compra-cant" placeholder="Cantidad" step="0.01" min="0" style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;width:110px;">
          <select id="nueva-compra-destino" onchange="onCambiarDestinoCompra()" style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;font-weight:700;color:#1a237e;">
            <option value="stocks">STOCKS</option>
            <option value="barra">BARRA</option>
            <option value="cocina">COCINA</option>
          </select>
          <button class="btn-detalles" id="btn-agregar-compra" onclick="agregarCompra()">➕ AGREGAR</button>
        </div>
        <div id="compras-almacenes" style="display:none;margin-top:0.75rem;padding:0.75rem;background:#e8f0fe;border-radius:8px;">
          <strong style="font-size:0.85rem;color:#1a237e;">Elige los almacenes donde ingresa esta compra (STOCKS):</strong>
          <div id="compras-almacenes-lista" style="display:flex;flex-wrap:wrap;gap:0.6rem 1rem;margin-top:0.4rem;"></div>
        </div>
        <div id="compras-muebles" style="display:none;margin-top:0.75rem;padding:0.75rem;background:#e8f0fe;border-radius:8px;">
          <strong style="font-size:0.85rem;color:#1a237e;">Elige el mueble del stock de BARRA donde ingresa esta compra:</strong>
          <div id="compras-muebles-lista" style="display:flex;flex-wrap:wrap;gap:0.6rem 1rem;margin-top:0.4rem;"></div>
        </div>
      </div>
      <div id="compras-detalle-container" style="margin-top:1.5rem;"></div>
    </div>

    <div id="tab-ventas-central" class="tab-content">
      <div class="header-actions">
        <h2>VENTAS</h2>
        <div class="controles-dia">
          <label>Fecha: <input type="date" id="fecha-ventas-menu" onchange="cargarVentasCentral()"></label>
          <button class="btn-guardar-dia" onclick="guardarVentasCentral()">💾 GUARDAR</button>
        </div>
      </div>
      <div style="margin-bottom:1rem;padding:1rem;background:#f9f9f9;border-radius:8px;">
        <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
          <select id="nueva-venta-destino" onchange="onCambiarDestinoVenta()" style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;font-weight:700;color:#1a237e;">
            <option value="stocks">STOCKS</option>
            <option value="barra">BARRA</option>
            <option value="cocina">COCINA</option>
          </select>
          <input type="text" id="nueva-venta-input" placeholder="Buscar item / receta..." list="sugerencia-ventas" autocomplete="off" style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;flex:1;min-width:180px;" oninput="onBuscarItemVenta(this.value)">
          <datalist id="sugerencia-ventas"></datalist>
          <input type="number" id="nueva-venta-cant" placeholder="Cantidad" step="0.01" min="0" style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;width:110px;">
          <button class="btn-detalles" id="btn-agregar-venta" onclick="agregarVenta()">➕ AGREGAR</button>
        </div>
        <div id="ventas-almacenes" style="display:none;margin-top:0.75rem;padding:0.75rem;background:#e8f0fe;border-radius:8px;">
          <strong style="font-size:0.85rem;color:#1a237e;">Elige los almacenes de donde sale esta venta (STOCKS):</strong>
          <div id="ventas-almacenes-lista" style="display:flex;flex-wrap:wrap;gap:0.6rem 1rem;margin-top:0.4rem;"></div>
        </div>
      </div>
      <div id="ventas-detalle-container" style="margin-top:1.5rem;"></div>
      <div style="margin-top:1.5rem;padding:1rem;background:#f9f9f9;border-radius:8px;border:1px dashed #ccc;">
        <h3 style="margin:0 0 0.5rem 0;">IMPORTAR VENTAS (EXCEL)</h3>
        <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
          <input type="file" id="ventas-excel-file" accept=".xlsx,.xls,.csv" style="display:none" onchange="onVentasExcelSeleccionado(this)">
          <button class="btn-guardar-dia" onclick="document.getElementById('ventas-excel-file').click()">SELECCIONAR EXCEL</button>
          <button class="btn-guardar-dia" onclick="registrarVentasImportadas()">REGISTRAR TODO</button>
        </div>
        <div style="font-size:0.8rem;color:#888;margin-top:0.4rem;">Columnas detectadas automáticamente: Fecha | Item | Cantidad (opcional Destino). La zona (STOCKS/BARRA/COCINA) se asigna en el modal y se guarda para la próxima vez.</div>
        <div id="ventas-import-preview"></div>
      </div>
      <div style="margin-top:1.5rem;padding:1rem;background:#eef7ee;border-radius:8px;border:1px dashed #2e7d32;">
        <h3 style="margin:0 0 0.5rem 0;">IMPORTAR VENTAS (EXCEL) PRUEBA</h3>
        <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
          <input type="file" id="ventas-excel-prueba-file" accept=".xlsx,.xls,.csv" style="display:none" onchange="onVentasExcelPruebaSeleccionado(this)">
          <button class="btn-guardar-dia" onclick="document.getElementById('ventas-excel-prueba-file').click()">SELECCIONAR EXCEL (PRUEBA)</button>
        </div>
        <div style="font-size:0.8rem;color:#2e7d32;margin-top:0.4rem;">Modo de prueba: analiza el archivo y muestra cómo quedaría, sin registrar ni guardar nada.</div>
        <div id="ventas-import-prueba-preview"></div>
      </div>
    </div>

    <div id="tab-busquedaventas" class="tab-content">
      <div class="header-actions">
        <h2>Búsqueda de Ventas</h2>
        <div class="controles-dia">
          <input type="text" id="busqueda-venta-item" placeholder="Buscar item..." list="busqueda-venta-sugerencias" autocomplete="off" style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;font-size:0.9rem;width:220px;">
          <datalist id="busqueda-venta-sugerencias"></datalist>
          <label>Desde: <input type="date" id="busqueda-venta-desde"></label>
          <label>Hasta: <input type="date" id="busqueda-venta-hasta"></label>
          <button class="btn-guardar-dia" onclick="buscarVentas()">🔍 BUSCAR</button>
          <button class="btn-detalles" onclick="exportarBusquedaVentas()">Exportar</button>
        </div>
      </div>
      <div id="busqueda-ventas-result"></div>
    </div>

    <div id="modal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="cerrarModal()">&times;</span>
      <div id="modal-body"></div>
      <datalist id="recetas-base-datalist"></datalist>
    </div>
  </div>

